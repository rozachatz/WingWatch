{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://passive-radar.local/schemas/radar-frame-v2.json",
  "title": "RadarFrame v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "frame_index",
    "timestamp",
    "receiver",
    "transmitter",
    "localization",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "replay",
        "live"
      ]
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "frequency_mhz": {
      "type": "number"
    },
    "receiver": {
      "$ref": "#/$defs/site"
    },
    "transmitter": {
      "$ref": "#/$defs/site"
    },
    "localization": {
      "type": "object",
      "required": [
        "available",
        "method",
        "note"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "none",
            "azimuth",
            "multistatic",
            "constrained",
            "demo"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "range_doppler_image_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": [
        "name",
        "latitude",
        "longitude",
        "altitude_m"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "altitude_m",
        "position_source"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "position_source": {
          "enum": [
            "azimuth",
            "multistatic",
            "constrained",
            "demo"
          ]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "track_id",
        "status",
        "bistatic_range_m",
        "excess_range_m",
        "range_rate_mps",
        "doppler_hz",
        "confidence",
        "age_frames",
        "misses",
        "position"
      ],
      "properties": {
        "track_id": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "tentative",
            "confirmed",
            "coasting"
          ]
        },
        "bistatic_range_m": {
          "type": "number"
        },
        "excess_range_m": {
          "type": "number"
        },
        "range_rate_mps": {
          "type": "number"
        },
        "doppler_hz": {
          "type": "number"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "age_frames": {
          "type": "integer",
          "minimum": 1
        },
        "misses": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/position"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
